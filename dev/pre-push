#!/usr/bin/env bash
# Pre-push-hook (installera: ln -sf ../../dev/pre-push .git/hooks/pre-push).
# Publikt repo: stoppa pushen om något personligt eller en nyckel finns med,
# i nuvarande version OCH i innehållet i varje commit som pushas.
root="$(git rev-parse --show-toplevel)"
export PK_PRIVATE_WORDS="$HOME/.config/pluggkompis/privata-ord"
z=0000000000000000000000000000000000000000
status=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && continue
  if [ "$rsha" = "$z" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
  "$root/dev/check-public.sh" --history "$range" || status=1
done
exit $status
